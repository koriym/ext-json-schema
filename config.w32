// vim:ft=javascript

ARG_ENABLE("json_schema", "enable json_schema", "no");

if (PHP_JSON_SCHEMA != "no") {
	EXTENSION("json_schema", "json_schema.c validator.c");
	AC_DEFINE('HAVE_JSON_SCHEMA', 1, 'whether json_schema is enabled');
	PHP_INSTALL_HEADERS("ext/json_schema/", "php_json_schema.h validator.h");
}
